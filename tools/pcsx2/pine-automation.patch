+bool ValidateInstrumentationLogFormat(DebugInterface& debug, const std::string& format, std::string& error);
+
+// Local addition, for driving the emulator from a script. A breakpoint or a memory check that is
+// set to carry on is only written to the log by the emulator. While the recorder is on, each hit
+// is kept here instead, with where the processor was and its registers, to be collected over the
+// control socket.
+struct RecordedHit
+{
+	u8 kind; // 0: an address was run. 1: memory was read or written.
+	u8 cpu; // a BreakPointCpu
+	u8 delaySlot; // the instruction is the one after pc, in the delay slot of the branch at pc
+	u8 unused;
+	u32 pc;
+	u32 address; // the breakpoint's address, or the start of the memory check's range
+	u32 frame; // the emulator's count of frames when it happened
+	u32 registers[32]; // the low 32 bits of each general register
+};
+
+namespace HitRecorder
+{
+	void SetEnabled(bool enabled);
+	bool IsEnabled();
+	void Record(BreakPointCpu cpu, u8 kind, u32 address);
+	// Takes up to `most` hits, oldest first, out of the recorder.
+	std::vector<RecordedHit> Take(size_t most);
+	void Clear();
+} // namespace HitRecorder
