+namespace HitRecorder
+{
+	// More than this many hits waiting to be collected are dropped.
+	static constexpr size_t MOST = 65536;
+	static std::mutex s_mutex;
+	static std::vector<RecordedHit> s_hits;
+	static std::atomic<bool> s_enabled{false};
+} // namespace HitRecorder
+
+void HitRecorder::SetEnabled(bool enabled)
+{
+	s_enabled.store(enabled);
+}
+
+bool HitRecorder::IsEnabled()
+{
+	return s_enabled.load();
+}
+
+void HitRecorder::Record(BreakPointCpu cpu, u8 kind, u32 address)
+{
+	RecordedHit hit = {};
+	hit.kind = kind;
+	hit.cpu = static_cast<u8>(cpu);
+	hit.address = address;
+	hit.frame = static_cast<u32>(g_FrameCount);
+	if (cpu == BREAKPOINT_IOP)
+	{
+		hit.pc = psxRegs.pc;
+		hit.delaySlot = (kind == 1) ? (psxIsMemcheckNeeded(hit.pc) == 2) : (address == hit.pc + 4);
+		for (int i = 0; i < 32; i++)
+			hit.registers[i] = psxRegs.GPR.r[i];
+	}
+	else
+	{
+		hit.pc = cpuRegs.pc;
+		hit.delaySlot = (kind == 1) ? (isMemcheckNeeded(hit.pc) == 2) : (address == hit.pc + 4);
+		for (int i = 0; i < 32; i++)
+			hit.registers[i] = cpuRegs.GPR.r[i].UL[0];
+	}
+	std::lock_guard lock(s_mutex);
+	if (s_hits.size() < MOST)
+		s_hits.push_back(hit);
+}
+
+std::vector<RecordedHit> HitRecorder::Take(size_t most)
+{
+	std::lock_guard lock(s_mutex);
+	const size_t count = std::min(most, s_hits.size());
+	std::vector<RecordedHit> taken(s_hits.begin(), s_hits.begin() + count);
+	s_hits.erase(s_hits.begin(), s_hits.begin() + count);
+	return taken;
+}
+
+void HitRecorder::Clear()
+{
+	std::lock_guard lock(s_mutex);
+	s_hits.clear();
+}
